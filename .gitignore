# Project
**/__pycache__/
*.py[cod]
.DS_Store
**/.DS_Store
.idea/
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.jupyter/
*.egg-info/
build/
dist/
.pytest_cache/
CLAUDE.md

# Dataset: audio of the Zenodo record and MFCC caches (the annotations, corrected, are tracked)
/canopy/datasets/marron1/*
!/canopy/datasets/marron1/annotations/

# outputs/<study>: the parts of the jobs (the Optuna databases, hpo/*_db.sqlite3, are tracked with Git LFS, and the
# result CSVs)
/outputs/*/hpo/parts/
/outputs/*/*/*_parts/
# GAN of the syllables: checkpoints (only the losses are tracked)
/outputs/syllable_generation/*/checkpoints/
/outputs/syllable_generation/*/last.pt

# Slurm logs and task lists of the jobs
/slurm/logs/
/slurm/tasks/

# Other datasets of vocalizations (canopy.datasets.vocalizations): recordings, annotations and MFCC caches
/canopy/datasets/bengalese_gy6or6/
/canopy/datasets/kerguelen2014/
/canopy/datasets/llb3/
/canopy/datasets/mouse_usv/
/canopy/datasets/incoming/

# Local: sources of the reports (articles and theses, under copyright) and the configuration of Claude Code
/reports/sources/
/.claude/
